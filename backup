<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Menu Digitale Smart</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Montserrat:wght@400;600;700&family=Oswald:wght@500;700&family=Roboto+Mono:wght@500&display=swap" rel="stylesheet">

<style>
/* ================= TEMI E VARIABILI ================= */
:root { --bg: #111; --text: #fff; --accent: #d4af37; --fade-speed: 0.8s; }

/* Nomi Temi utilizzabili nello Sheet: 
   Classic, Dark, Elegant, Midnight, Amber, Minimal, Neon, Pub */
.theme-classic  { --bg: #0f0f0f; --text: #ffffff; --accent: #d4af37; }
.theme-dark     { --bg: #000000; --text: #e0e0e0; --accent: #00ff88; }
.theme-elegant  { --bg: #1a1a1a; --text: #f5f5f5; --accent: #e5c07b; }
.theme-midnight { --bg: #00040d; --text: #e0e0ff; --accent: #4cc9f0; }
.theme-amber    { --bg: #12100e; --text: #fff4e0; --accent: #ffb703; }
.theme-minimal  { --bg: #ffffff; --text: #1a1a1a; --accent: #000000; }
.theme-neon     { --bg: #050505; --text: #fff;    --accent: #f72585; }
.theme-pub      { --bg: #1c140d; --text: #f3e9dc; --accent: #e29578; }

/* ================= STRUTTURA BASE ================= */
* { box-sizing: border-box; }
body { 
    margin: 0; padding: 0; width: 100%; height: 100dvh; 
    font-family: 'Montserrat', sans-serif; 
    background-color: var(--bg); color: var(--text);
    display: flex; flex-direction: column; overflow: hidden;
    transition: background 0.5s ease;
}

/* Effetto Fade-In per aggiornamento dati */
#menu.updating { opacity: 0; transform: translateY(10px); }
#menu { 
    opacity: 1; transform: translateY(0); 
    transition: opacity var(--fade-speed) ease, transform var(--fade-speed) ease; 
}

/* ================= HEADER ================= */
#header {
    flex-shrink: 0; display: flex; align-items: center; justify-content: center;
    padding: 1.5vh 3vw; gap: 2vw; z-index: 10;
}
#logo { height: 10vh; width: auto; object-fit: contain; display: none; }
#title {
    font-family: 'Playfair Display', serif; text-transform: uppercase;
    margin: 0; font-size: clamp(24px, 6vh, 60px); color: var(--accent);
}

/* ================= CORPO CENTRALE ================= */
#scroll-container {
    flex-grow: 1; overflow-y: auto; padding: 2vh 4vw;
}

/* Layout adattivo: Colonne su TV/PC, Lista su Mobile */
#menu {
    width: 100%; max-width: 2200px; margin: 0 auto;
    column-width: 400px; column-gap: 5vw; column-rule: 1px solid rgba(255,255,255,0.05);
}

/* Categorie */
.category { 
    break-inside: avoid; margin-bottom: 4vh; 
    display: inline-block; width: 100%; 
}
.category h2 {
    margin: 0 0 2vh 0; border-bottom: 3px solid var(--accent);
    text-transform: uppercase; font-size: 1.8rem; padding-bottom: 5px;
    color: var(--accent); font-family: 'Oswald', sans-serif;
}

/* Piatti e Drink */
.item-box { margin-bottom: 2.5vh; }
.item-header { 
    display: flex; justify-content: space-between; align-items: baseline;
    font-weight: 700; font-size: 1.3rem; gap: 10px;
}
.price { color: var(--accent); font-family: 'Roboto Mono', monospace; }
.desc { font-style: italic; font-size: 0.95rem; opacity: 0.8; line-height: 1.4; margin-top: 4px; }

/* Prezzo Full Width in fondo */
#prezzo-box {
    margin: 2vh auto; padding: 15px; width: 90%;
    border: 2px solid var(--accent); border-radius: 12px;
    text-align: center; font-size: 1.5rem; font-weight: 800;
    color: var(--accent); display: none;
}

/* ================= MOBILE OPTIMIZATION ================= */
@media (max-width: 768px) {
    #menu { column-count: 1; column-width: auto; }
    #header { flex-direction: column; text-align: center; }
    #logo { height: 8vh; }
    #title { font-size: 8vw; }
    .item-header { font-size: 1.1rem; }
}

/* ================= PROMO ================= */
#promo {
    position: fixed; inset: 0; background-color: #000; 
    background-position: center; background-repeat: no-repeat; background-size: contain;
    opacity: 0; pointer-events: none; transition: opacity 0.8s ease; z-index: 9999;
}
#promo.show { opacity: 1; }

</style>
</head>
<body class="theme-classic">

<div id="header">
    <img id="logo" alt="Logo">
    <h1 id="title">...</h1>
</div>

<div id="scroll-container">
    <div id="menu"></div>
    <div id="prezzo-box"></div>
</div>

<div id="promo"></div>

<script>
const SHEET_ID = "1wKMa0cmpQVWNmzYb9y3oTB5lpuEIa8GTXdYqiG3836c";

// Utility per pulizia dati
const getVal = (r, k) => { 
    const key = Object.keys(r).find(y => y.toLowerCase().trim() === k.toLowerCase().trim()); 
    return key ? r[key] : ""; 
};
const clean = v => (v || "").toString().trim();

async function updateData() {
    try {
        const menuEl = document.getElementById("menu");
        menuEl.classList.add("updating"); // Inizia fade-out

        const settingsRaw = await fetch(`https://opensheet.elk.sh/${SHEET_ID}/Impostazioni`).then(r => r.json());
        const S = {}; settingsRaw.forEach(r => S[getVal(r, "Proprietà")] = getVal(r, "Valore"));

        const MODE = clean(S["Modalità"]).toLowerCase();
        const themeName = (MODE === "bar" ? S["Tema Bar"] : S["Tema Cucina"]) || "Classic";
        document.body.className = `theme-${themeName.toLowerCase()}`;

        // Personalizzazione Font se specificati
        if(S["Font Titolo"]) document.getElementById("title").style.fontFamily = S["Font Titolo"];
        if(S["Font Testo"]) document.body.style.fontFamily = S["Font Testo"];

        document.getElementById("title").innerText = MODE === "bar" ? S["Titolo Bar"] : S["Titolo Cucina"];
        
        const logoEl = document.getElementById("logo");
        if (S["Logo URL"]) { logoEl.src = S["Logo URL"]; logoEl.style.display = "block"; }

        // Gestione Promo (Solo se modalità è Bar)
        if (MODE === "bar" && S["Immagine Promo"]) {
            startPromo(S["Immagine Promo"], S["Tempo Promo"]);
        } else {
            stopPromo();
        }

        // Recupero Dati Menu
        const sheetName = MODE === "cucina" ? "Menu" : "Bar";
        const data = await fetch(`https://opensheet.elk.sh/${SHEET_ID}/${sheetName}`).then(r => r.json());

        // Raggruppamento categorie
        const grouped = {};
        data.forEach(r => {
            if (clean(getVal(r, "Disponibile")).toLowerCase() !== "si") return;
            const cat = clean(getVal(r, "Categoria")).toUpperCase();
            if (!cat) return;
            grouped[cat] ??= [];
            grouped[cat].push({
                n: getVal(r, "Piatto") || getVal(r, "Nome"),
                ing: getVal(r, "Ingredienti") || "",
                p: getVal(r, "Prezzo")
            });
        });

        // Ordinamento Categorie (se specificato per il Bar)
        let categories = Object.keys(grouped);
        if (MODE === "bar" && S["Ordine Categorie Bar"]) {
            const order = S["Ordine Categorie Bar"].split(',').map(s => s.trim().toUpperCase());
            categories.sort((a, b) => {
                let idxA = order.indexOf(a);
                let idxB = order.indexOf(b);
                return (idxA === -1 ? 99 : idxA) - (idxB === -1 ? 99 : idxB);
            });
        }

        // Rendering HTML
        setTimeout(() => {
            menuEl.innerHTML = categories.map(cat => `
                <div class="category">
                    <h2>${cat}</h2>
                    ${grouped[cat].map(x => `
                        <div class="item-box">
                            <div class="item-header">
                                <span>${x.n}</span>
                                <span class="price">${x.p}</span>
                            </div>
                            ${x.ing ? `<div class="desc" style="opacity:${(S["Trasparenza Ingredienti"] || "0.8").replace(',','.')}">${x.ing}</div>` : ''}
                        </div>
                    `).join('')}
                </div>
            `).join('');

            const pBox = document.getElementById("prezzo-box");
            if (MODE === "cucina" && S["Prezzo"]) {
                pBox.innerHTML = S["Prezzo"];
                pBox.style.display = "block";
            } else {
                pBox.style.display = "none";
            }

            menuEl.classList.remove("updating"); // Fine fade-in
        }, 800);

    } catch (e) { console.error("Errore aggiornamento:", e); }
}

/* ===================== PROMO LOGIC ===================== */
let promoInterval = null;
function startPromo(url, duration) {
    const el = document.getElementById("promo");
    if (el.style.backgroundImage.includes(url)) return;
    
    clearInterval(promoInterval);
    el.style.backgroundImage = `url(${url})`;
    const sec = (parseInt(duration) || 10) * 1000;

    const run = () => {
        el.classList.add("show");
        setTimeout(() => el.classList.remove("show"), sec);
    };
    run();
    promoInterval = setInterval(run, sec * 3); // Mostra ogni 3 intervalli
}

function stopPromo() {
    clearInterval(promoInterval);
    document.getElementById("promo").classList.remove("show");
}

/* ===================== INIT ===================== */
updateData();
setInterval(updateData, 15000); // Aggiorna ogni 15 secondi
</script>
</body>
</html>
