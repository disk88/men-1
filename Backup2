    menu.style.gridTemplateRows = `repeat(${maxR}, 1fr)`;
    menu.style.gridTemplateColumns = `repeat(${maxC}, 1fr)`;
    for(let i=1; i<=count; i++) { const el = document.getElementById(`cat-${i}`); if(el && pos[i]) { el.style.gridRow = pos[i][0]; el.style.gridColumn = pos[i][1]; } }
}

// --- LOGICA PROMO ---
let promoInterval = null;
function handlePromo(url, time) {
    if(promoInterval) return;
    const p = document.getElementById("promo");
    p.style.backgroundImage = `url(${url})`;
    const t = (parseInt(time) || 10) * 1000;
    const cycle = () => { p.classList.add("show"); setTimeout(() => p.classList.remove("show"), t); };
    cycle(); promoInterval = setInterval(cycle, t * 5);
}
function stopPromo() { clearInterval(promoInterval); promoInterval = null; document.getElementById("promo").classList.remove("show"); }

// Avvio iniziale e loop
updateData();
setInterval(updateData, 20000);
window.addEventListener('resize', maximizeFont);
</script>
